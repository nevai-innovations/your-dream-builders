# Copy this file to .env.local (for `vercel dev`) and fill in real values.
# Never commit the real .env / .env.local file.

# The single shared password that unlocks /update (the work-photo CMS).
# Choose something you wouldn't mind sharing with whoever manages the gallery.
UPDATE_PAGE_PASSWORD=

# From the Vercel dashboard: Storage tab -> create a Blob store -> .env.local tab.
# Needed locally only for running scripts/seed-work-photos.mjs; in production
# Vercel injects this automatically once a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
